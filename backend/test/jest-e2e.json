{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@prisma/client/runtime/client$": "<rootDir>/node_modules/@prisma/client/runtime/client.js",
    "^(\\./.*)\\.js$": "$1"
  }
}
